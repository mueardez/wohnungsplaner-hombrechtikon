rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && exists(/databases/$(database)/documents/access/$(request.auth.token.email));
    }
    match /access/{email} {
      allow get: if member() && email == request.auth.token.email;
      allow list, write: if false;
    }
    match /households/hombrechtikon/items/{item} {
      allow read, delete: if member();
      allow create, update: if member()
        && request.resource.data.id == item
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 500
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 20000
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.quantity <= 10000
        && (!('photo' in request.resource.data) || request.resource.data.photo.matches('households/hombrechtikon/photos/[^/]+'));
    }
    match /households/hombrechtikon/settings/move {
      allow read: if member();
      allow create, update: if member()
        && request.resource.data.oldHome is map
        && request.resource.data.newHome is map
        && request.resource.data.oldHome.photos is list
        && request.resource.data.newHome.photos is list
        && request.resource.data.oldHome.photos.size() <= 3
        && request.resource.data.newHome.photos.size() <= 3;
    }
  }
}
