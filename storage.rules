rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function member() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && firestore.exists(/databases/(default)/documents/access/$(request.auth.token.email));
    }
    match /households/hombrechtikon/photos/{photo} {
      allow read: if member();
      allow create: if member() && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      // Immutable photo names keep concurrent edits from overwriting one another.
      allow update, delete: if false;
    }
  }
}
